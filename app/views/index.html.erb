<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= h config["title"] %>: Metro Detroit grappling schedule</title>
<meta name="description" content="<%= timetable.classes.size %> jiu jitsu, wrestling and judo classes at <%= timetable.gyms.size %> Metro Detroit gyms. Filter by day, age and discipline, then print it.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Cpath fill='%23c8102e' d='M0 0h8v16H0z'/%3E%3Cpath fill='%230a3fa8' d='M8 0h8v16H8z'/%3E%3C/svg%3E">
<style><%= stylesheet %></style>
</head>
<body>
<a class="skip" href="#schedule">Skip to the schedule</a>
<div class="layout">
  <aside class="sidebar">
    <header class="brand">
      <h1><%= h config["title"] %></h1>
      <p><%= timetable.classes.size %> classes at <%= timetable.gyms.size %> gyms around Metro Detroit. Updated <%= pulled_on %>.</p>
    </header>
    <details id="filters" class="filters">
      <summary>Filter and print</summary>
      <form id="filter-form">
        <%= render("filters") %>
        <fieldset class="group layout-choice">
          <legend>Layout</legend>
          <label><input type="radio" name="view" value="week" checked> Week grid</label>
          <label><input type="radio" name="view" value="list"> Day by day</label>
          <label><input type="radio" name="view" value="map"> Map</label>
        </fieldset>
      </form>
      <div class="group print-menu">
        <h2>Print</h2>
        <p>Uses the filters you've set.</p>
        <button type="button" class="text-button" data-print-as="list">Day-by-day list</button>
        <button type="button" class="text-button" data-print-as="week">Week grid, landscape</button>
        <button type="button" class="text-button" data-print-as="gyms">Gym addresses</button>
      </div>
    </details>
    <% if support? %>
      <a class="support" href="<%= h config["support_url"] %>" target="_blank" rel="noopener"><%= h config["support_label"] %></a>
    <% end %>
  </aside>
  <main>
    <p class="print-only"><%= h config["title"] %>, Metro Detroit. Updated <%= pulled_on %>. Confirm times with the gym.</p>
    <div class="toolbar">
      <p id="result-count" class="visually-hidden" aria-live="polite"><%= timetable.classes.size %> classes</p>
      <button type="button" class="text-button" data-clear hidden>Clear filters</button>
      <button type="button" class="text-button" data-map-toggle>Map</button>
      <a class="jump" href="#gyms">All gyms, addresses and websites</a>
    </div>
    <p id="no-results" hidden>Nothing matches those filters. Try removing one.</p>
    <div id="schedule" class="days" data-view="week" style="--rows: <%= timetable.start_times.size + 1 %>; --cols: <%= timetable.by_day.size %>">
      <ol class="hours">
        <% timetable.start_times.each do |start_time| %>
          <li class="hour" style="--row: <%= row_for(start_time) %>"><span><%= MatTimes::Clock.format(start_time) %></span></li>
        <% end %>
      </ol>
      <% timetable.by_day.each_with_index do |(day, entries), index| %>
        <section class="day" id="<%= day.downcase %>" style="--col: <%= index + 2 %>">
          <h2><%= day %> <span class="day-count"><%= entries.size %></span></h2>
          <% entries.group_by(&:starts_at).each do |start_time, slot| %>
            <ol class="slot" style="--row: <%= row_for(start_time) %>">
              <% slot.each do |entry| %><%= render("entry", entry: entry) %><% end %>
            </ol>
          <% end %>
        </section>
      <% end %>
    </div>
    <div id="map" class="map" hidden></div>
    <section id="gyms" class="gyms">
      <h2>Gyms</h2>
      <% gym_sections.each do |section, gyms| %>
        <details class="gym-section" data-section="<%= section %>" open>
          <summary><%= SECTIONS.fetch(section) %> <span class="count"><%= gyms.size %></span></summary>
          <div class="gym-grid">
            <% gyms.each do |gym| %><%= render("gym", gym: gym) %><% end %>
          </div>
        </details>
      <% end %>
    </section>
    <footer class="site-footer">
      <p>Schedules change. Check with the gym before you drive over.</p>
      <% unless config["repo_url"].to_s.empty? %>
        <p><a href="<%= h config["repo_url"] %>/issues">Report a wrong time or a dead link</a></p>
      <% end %>
      <% if support? %>
        <p><a href="<%= h config["support_url"] %>" target="_blank" rel="noopener"><%= h config["support_label"] %></a></p>
      <% end %>
    </footer>
  </main>
</div>
<dialog id="gym-card" aria-label="Gym details">
  <div data-gym-slot></div>
  <div class="dialog-actions">
    <button type="button" class="outline-button" data-only-gym value="">Show only this gym's classes</button>
    <button type="button" class="text-button" data-close>Close</button>
  </div>
</dialog>
<script type="application/json" id="gym-pins"><%= pins_json %></script>
<script type="module"><%= asset("application.js") %></script>
</body>
</html>
