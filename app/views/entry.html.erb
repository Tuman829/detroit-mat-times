<li class="entry"<% facets(entry).each do |facet, values| %> data-<%= facet %>="<%= values.join(" ") %>"<% end %>>
  <span class="time<%= " ranged" if entry.ends_at %>"><%= entry.time_label %></span>
  <div class="entry-text">
    <h3><%= h entry.title %></h3>
    <p class="where"><a href="#gym-<%= entry.gym.slug %>" data-gym-link="<%= entry.gym.slug %>"><%= h entry.gym.name %></a>, <a class="town" href="<%= h entry.gym.directions_url %>" target="_blank" rel="noopener"><%= h entry.gym.city %></a></p>
    <% unless details(entry).empty? %><p class="detail"><% details(entry).each do |detail| %><span<%= ' class="open"' if detail == "Open mat" %>><%= h detail %></span><% end %></p><% end %>
  </div>
  <p class="links">
    <% if entry.gym.website %><a href="<%= h entry.gym.website %>" target="_blank" rel="noopener">Site</a><% end %>
    <a href="<%= h entry.gym.map_url %>" target="_blank" rel="noopener">Map</a>
  </p>
</li>
