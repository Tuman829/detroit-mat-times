<details class="group long">
  <summary><%= legend %></summary>
  <fieldset>
    <legend class="visually-hidden"><%= legend %></legend>
    <% choices.each do |value, label| %>
      <label><input type="checkbox" name="<%= facet %>" value="<%= value %>"> <span><%= h label %></span></label>
    <% end %>
  </fieldset>
</details>
